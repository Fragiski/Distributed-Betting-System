<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/txtReviewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rate Game"
        android:textColor="#D4AF37"
        android:textSize="22sp"
        android:fontFamily="@font/montserrat_bold"
        android:layout_marginBottom="16dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40B0C4DE"
        android:layout_marginBottom="20dp"/>

    <RatingBar
        android:id="@+id/dialogRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1.0"
        android:progressTint="#D4AF37"
        android:progressBackgroundTint="#40B0C4DE"
        android:layout_marginBottom="20dp"
        style="?android:attr/ratingBarStyle" />

    <EditText
        android:id="@+id/editReviewComment"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_spinner_field"
        android:hint="Write your review here..."
        android:textColorHint="#60B0C4DE"
        android:textColor="#FFFFFF"
        android:gravity="top|start"
        android:padding="12dp"
        android:textSize="14sp"
        android:fontFamily="@font/montserrat_regular"
        android:layout_marginBottom="24dp"
        android:inputType="textMultiLine"
        android:importantForAutofill="no"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelReview"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:backgroundTint="#20FFFFFF"
            app:strokeColor="#40B0C4DE"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:text="Cancel"
            android:textColor="#B0C4DE"
            android:textSize="12sp"
            android:fontFamily="@font/montserrat_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:backgroundTint="#D4AF37"
            app:cornerRadius="12dp"
            android:text="SUBMIT"
            android:textColor="#0D1B2E"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>

</LinearLayout>